#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

usage() {
  cat <<'USAGE'
Usage: ugreen-remote COMMAND [ARGS]

Commands:
  audit-home                 Read-only Seattle inventory
  audit-nas                  Read-only UGOS inventory
  audit-aws                  Read-only ap-east-1 and Route 53 inventory
  generate-keys ROLE         ROLE: home, nas, primary-admin,
                             recovery-admin, recovery-tunnel
  render                     Render local private configuration from site.env
  validate                   Static and private-config validation
USAGE
}

command_name=${1:-}
shift || true

case "$command_name" in
  audit-home) exec "$ROOT_DIR/scripts/audit-home.sh" "$@" ;;
  audit-nas) exec "$ROOT_DIR/scripts/audit-nas.sh" "$@" ;;
  audit-aws) exec "$ROOT_DIR/scripts/audit-aws.sh" "$@" ;;
  generate-keys) exec "$ROOT_DIR/scripts/generate-keys.sh" "$@" ;;
  render) exec "$ROOT_DIR/scripts/render.sh" "$@" ;;
  validate) exec "$ROOT_DIR/scripts/validate.sh" "$@" ;;
  -h|--help|help|'') usage ;;
  *) usage >&2; exit 2 ;;
esac

