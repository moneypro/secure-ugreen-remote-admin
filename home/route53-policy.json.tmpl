{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UpdateOneRecord",
      "Effect": "Allow",
      "Action": "route53:ChangeResourceRecordSets",
      "Resource": "arn:aws:route53:::hostedzone/REPLACE_ZONE_ID",
      "Condition": {
        "ForAllValues:StringEquals": {
          "route53:ChangeResourceRecordSetsRecordTypes": ["A"],
          "route53:ChangeResourceRecordSetsActions": ["UPSERT"],
          "route53:ChangeResourceRecordSetsNormalizedRecordNames": ["REPLACE_RECORD_NAME"]
        }
      }
    },
    {
      "Sid": "ReadZone",
      "Effect": "Allow",
      "Action": "route53:ListResourceRecordSets",
      "Resource": "arn:aws:route53:::hostedzone/REPLACE_ZONE_ID"
    }
  ]
}

